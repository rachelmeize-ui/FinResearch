  "narrative": {
    "northStar": "可追溯的金融研究工作台",
    "overview": "Operate 模式：供金融专业学生、研究实习生和初级分析人员连续阅读、比较财务表格并核对来源。采用用户确定的白、灰、深蓝专业金融 SaaS 方向，以名称、文本和数据组织界面；不依赖装饰图片或复制参考产品的品牌资产。\n\n白色工作面置于浅灰画布，深蓝标记主操作、当前位置和证据入口。细线分隔与紧凑排版保持数据密度；首页、列表、研究工作区与报告预览属于同一视觉系统。本文为实现扫描结果，来源为 `static/index.html`、`static/style.css`、`static/app.js`；旧版绿色侧栏规范保存在 `archive/ui-before-20261121-DESIGN.md`。",
    "keyCharacteristics": [
      "白灰工作面、克制深蓝与清晰边界。",
      "紧凑表格、右对齐金额和等宽数字。",
      "状态使用文字，来源入口就近可见。",
      "系统中文字体、键盘焦点与窄屏重排。"
    ],
    "rules": [
      {
        "name": "The Meaning Before Color Rule",
        "body": "状态必须保留明确文字；公司对比色不得解释为涨跌、投资评级或收益预测。",
        "section": "colors"
      },
      {
        "name": "The Exact Value Rule",
        "body": "不为视觉整齐改写财务值；缺失值显示破折号，原始金额、页面亿元和比例单位必须可辨认。",
        "section": "typography"
      },
      {
        "name": "The Flat Work Surface Rule",
        "body": "普通内容不增加浮动投影；深度用于正在核验的覆盖面板。",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** 使用同一研究上下文串联概览、比较、来源核验和报告。",
      "**Do** 保留金额单位、报告期、合并口径、来源和 AI 初稿状态。",
      "**Do** 让表格在自身容器内滚动，并提供可见键盘焦点。",
      "**Do** 为等待、失败、缺数据和未生成内容提供明确文字与下一步。"
    ],
    "donts": [
      "**Don't** 加入渐变、装饰图片、大圆角胶囊或膨胀的指标卡片。",
      "**Don't** 用红绿替代公司身份、用颜色替代核验文字。",
      "**Don't** 把历史年报柱形画成连续行情走势，或暗示实时行情已接入。",
      "**Don't** 将固定公式、既有 AI 初稿和人工已确认结论混为一种可信状态。"
    ]
  }
}
